  "cards": [
    {
      "dot": "cyan",
      "title": "Ekstraksi multi-format berbasis VLM",
      "items": [
        "Mendukung PDF, DOCX, XLSX/ODS, PPTX, dan scan gambar melalui rendering headless LibreOffice dan PyMuPDF.",
        "Bukan OCR sederhana: VLM memahami layout kolom, struktur tabel, konteks visual, dan 6 spesifikasi komposit."
      ]
    },
    {
      "dot": "emerald",
      "title": "Orkestrasi adaptif & scaffold deterministik",
      "items": [
        "Surveyor memetakan sekat kolom, awal baris, dan deskew tanpa LLM sebagai perancah presisi bagi VLM.",
        "Job Tracker mengelola eksekusi background independen dari tab UI dengan slot concurrency dan tracking status granular."
      ]
    },
    {
      "dot": "violet",
      "title": "Data terstruktur & loop pembelajaran",
      "items": [
        "Tabel transaksi di-ingest ke SQLite relasional dengan verifikasi ganda saldo untuk kalkulasi SQL berpresisi 100%.",
        "DSPy 3.3.1 dan GEPA 0.1.4 mengoptimalkan prompt sistem dari koreksi pengguna tanpa mengubah bobot model."
      ]
    }
  ]
