[Unit]
Description=VLM Server - Gemma 4 26B
After=network.target
Wants=streamlit.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/jds-magang-ocr-agent/model
ExecStart=/bin/bash %h/jds-magang-ocr-agent-v2/logged-exec.sh %h/jds-magang-ocr-agent-v2/logs/llama-server.log /usr/local/bin/llama-server -m gemma-4-26B/gemma-4-26B-A4B-it-UD-Q3_K_M.gguf --mmproj gemma-4-26B/mmproj-BF16.gguf --jinja -ngl 200 --ctx-size 8192 --parallel 1 --host 0.0.0.0 --port 8080 --alias gemma-4-26b-vlm --reasoning off --image-min-tokens 1120 --image-max-tokens 1120 --ubatch-size 2048 --batch-size 2048 --temp 0.1 --top-p 0.9 --top-k 20 --repeat-penalty 1.05
ExecStartPost=%h/jds-magang-ocr-agent/.venv/bin/python %h/jds-magang-ocr-agent-v2/wait-llama.py
TimeoutStartSec=660
TimeoutStopSec=60
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
