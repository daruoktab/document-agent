# ============================================================================
#  KONFIGURASI LENGKAP — Document Vision OCR & Text Extractor
#
#  >>> CUKUP ISI: LLM_API_KEY <<<
#  Salin file ini menjadi `.env` (atau edit file `.env` yang sudah ada).
# ============================================================================

# ----------------------------------------------------------------------------
# GLOBAL — Base URL & API Key
# ----------------------------------------------------------------------------
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=

# ----------------------------------------------------------------------------
# 1. VLM NORMAL — Ekstraksi Dokumen & Layout Reasoning ke Markdown
# ----------------------------------------------------------------------------
VLM_MODEL=qwen-35b-vision
VLM_ENABLE_THINKING=false
VLM_TEMPERATURE=0.1
VLM_TIMEOUT=300
VLM_MAX_TOKENS=4096

# Pembelajaran DSPy/GEPA: opsional, default data/learning di root proyek.
# Gunakan direktori yang sama pada Streamlit dan terminal admin, di luar output/.
# LEARNING_DATA_DIR=C:/lokasi/data/learning

# ----------------------------------------------------------------------------
# 2. OCR — Model tuned untuk pembacaan teks mentah beresolusi tinggi
# ----------------------------------------------------------------------------
OCR_MODEL=ocr-lighton
OCR_TEMPERATURE=0.0
OCR_TIMEOUT=300
OCR_MAX_TOKENS=500
