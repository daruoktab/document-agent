# ============================================================================
# 1. VLM Utama (Gemma) — reasoning, layout, specialist Mermaid, & judge
# ============================================================================
BASE_URL=http://127.0.0.1:8080/v1
VLM_MODEL=gemma-4-26b-vlm
VLM_ENABLE_THINKING=true
VLM_VISUAL_RESCUE=true
VLM_TEMPERATURE=0.1
VLM_TIMEOUT=300
VLM_MAX_TOKENS=2048

# ============================================================================
# 2. PaddleOCR-VL — layout lokal + recognizer GGUF llama.cpp
# ============================================================================
OCR_BACKEND=paddleocr_vl
OCR_BASE_URL=http://127.0.0.1:8081/v1
OCR_MODEL=paddleocr-vl-1.6
OCR_TEMPERATURE=0.0
OCR_TIMEOUT=300
OCR_MAX_TOKENS=4096
OCR_MIN_TRUST_SCORE=0.72
OCR_ROTATION_RETRY=true
TEXTREFLOW_ENABLED=true

# ============================================================================
# 3. Spreadsheet hybrid — survei sel native + render per region
# ============================================================================
EXCEL_NATIVE_SURVEY=true
EXCEL_REGION_RENDERING=true
EXCEL_BASE_DPI=300
EXCEL_MAX_DPI=450
EXCEL_SMALL_FONT_POINTS=8
EXCEL_MAX_REGION_COLUMNS=18
EXCEL_MAX_REGION_ROWS=80
EXCEL_TILE_MAX_COLUMNS=12
EXCEL_TILE_MAX_ROWS=40
