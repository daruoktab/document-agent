# ============================================================================
# 1. vlm-vision-focus (Gemma) — baca gambar dan audit visual
# ============================================================================
VLM_VISION_FOCUS_BASE_URL=http://127.0.0.1:8080/v1
VLM_VISION_FOCUS_API_KEY=not-needed
VLM_VISION_FOCUS_MODEL=gemma-4-12b-vlm
VLM_VISION_FOCUS_ENABLE_THINKING=false
VLM_VISION_FOCUS_VISUAL_RESCUE=true
VLM_VISION_FOCUS_TEMPERATURE=0.1
VLM_VISION_FOCUS_TIMEOUT=300
VLM_VISION_FOCUS_MAX_TOKENS=2048

# ============================================================================
# 2. vlm-agent-focus — kosong berarti alur Gemma lama tetap dipakai
# Endpoint dan API key default mengikuti vlm-vision-focus bila tidak diisi.
# Model ini perlu mendukung tool calling untuk Deep Agent via MCP.
# ============================================================================
VLM_AGENT_FOCUS_MODEL=
VLM_AGENT_FOCUS_BASE_URL=
VLM_AGENT_FOCUS_API_KEY=
VLM_AGENT_FOCUS_TEMPERATURE=0.1
VLM_AGENT_FOCUS_TIMEOUT=300
VLM_AGENT_FOCUS_MAX_TOKENS=2048
VLM_AGENT_FOCUS_ENABLE_THINKING=false

# ============================================================================
# 3. PaddleOCR-VL — layout lokal + recognizer GGUF llama.cpp
# ============================================================================
OCR_BACKEND=paddleocr_vl
OCR_BASE_URL=http://127.0.0.1:8081/v1
OCR_MODEL=paddleocr-vl-1.6
OCR_TEMPERATURE=0.0
OCR_TIMEOUT=300
OCR_MAX_TOKENS=4096
OCR_MIN_TRUST_SCORE=0.72
OCR_ROTATION_RETRY=true
TEXTREFLOW_ENABLED=true

# ============================================================================
# 4. Spreadsheet hybrid — survei sel native + render per region
# ============================================================================
EXCEL_NATIVE_SURVEY=true
EXCEL_REGION_RENDERING=true
EXCEL_BASE_DPI=300
EXCEL_MAX_DPI=450
EXCEL_SMALL_FONT_POINTS=8
EXCEL_MAX_REGION_COLUMNS=18
EXCEL_MAX_REGION_ROWS=80
EXCEL_TILE_MAX_COLUMNS=12
EXCEL_TILE_MAX_ROWS=40
