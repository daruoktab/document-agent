# ============================================================================
# 1. VLM Utama (Qwen) — reasoning, layout, specialist Mermaid, & judge
# ============================================================================
BASE_URL=http://127.0.0.1:8080/v1
VLM_MODEL=qwen-35b-vision
VLM_ENABLE_THINKING=false
VLM_VISUAL_RESCUE=true
VLM_TEMPERATURE=0.1
VLM_TIMEOUT=300

# ============================================================================
# 2. Unlimited-OCR — grounding draft, koordinat bbox, & crop tabel/diagram
# ============================================================================
OCR_BASE_URL=http://127.0.0.1:8081/v1
OCR_MODEL=Unlimited-OCR-Q8_0.gguf
OCR_TEMPERATURE=0.0
OCR_TIMEOUT=300
OCR_MAX_TOKENS=4096
OCR_PROMPT=<|grounding|>Convert the document to markdown.
OCR_COORDINATE_SIZE=1024
OCR_MIN_TRUST_SCORE=0.72
OCR_ROTATION_RETRY=true

# ============================================================================
# 3. Spreadsheet hybrid — survei sel native + render per region
# ============================================================================
EXCEL_NATIVE_SURVEY=true
EXCEL_REGION_RENDERING=true
EXCEL_BASE_DPI=300
EXCEL_MAX_DPI=450
EXCEL_SMALL_FONT_POINTS=8
EXCEL_MAX_REGION_COLUMNS=18
EXCEL_MAX_REGION_ROWS=80
