[Unit]
Description=PaddleOCR-VL 1.6 Recognizer
After=network.target
Wants=streamlit.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/document-agent/model
ExecStart=/bin/bash %h/document-agent/deploy/server/logged-exec.sh %h/document-agent/logs/ocr-server.log /usr/local/bin/llama-server -m PaddleOCR-VL-1.6-GGUF.gguf --mmproj PaddleOCR-VL-1.6-GGUF-mmproj.gguf --device CUDA0 --mmproj-device CUDA0 --jinja -ngl 999 --ctx-size 16384 --parallel 1 --host 0.0.0.0 --port 8081 --alias paddleocr-vl-1.6 --reasoning off --ubatch-size 2048 --batch-size 2048 --temp 0.0 --top-p 0.9 --top-k 20 --repeat-penalty 1.0
ExecStartPost=%h/document-agent/.venv/bin/python %h/document-agent/deploy/server/wait-ocr.py
TimeoutStartSec=660
TimeoutStopSec=60
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
